# PharmaFlow / Hind HealthCare
#
# Local development:
DATABASE_URL=sqlite:///./hind_pharma.db
#
# Live cPanel / MySQL:
# DATABASE_URL=mysql+pymysql://MYSQL_USER:MYSQL_PASSWORD@MYSQL_HOST:3306/MYSQL_DATABASE
#
# Runtime:
HIND_PHARMA_ENV=development
HIND_PHARMA_SEED_DEMO_DATA=true
HIND_PHARMA_AUTH_SECRET=replace-with-a-long-random-secret

# Production values MUST be configured in cPanel/Python App environment
# variables. Never commit real credentials or secrets.
